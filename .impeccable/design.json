      "html": "<div class=\"ds-menu\"><button class=\"ds-mi\">Rename</button><button class=\"ds-mi\">Duplicate</button><div class=\"ds-msep\"></div><button class=\"ds-mi ds-mi-danger\">Move to trash</button></div>",
      "css": ".ds-menu{width:200px;padding:4px;border-radius:6px;background:var(--surface,#fff);box-shadow:0 0 0 1px var(--hairline,#E4E4E0),0 12px 28px -14px rgba(20,20,20,0.28)}.ds-mi{display:flex;width:100%;padding:7px 10px;border:none;background:none;border-radius:4px;text-align:left;font-family:var(--font-ui);font-size:13px;color:var(--text,#141414);cursor:pointer;outline:none;transition:background 140ms cubic-bezier(0.16,1,0.3,1)}.ds-mi:hover,.ds-mi:focus-visible{background:var(--hover-wash,#F3F3F0)}.ds-mi:focus-visible{box-shadow:inset 2px 0 0 var(--accent,#29524A)}.ds-mi-danger{color:var(--danger,#B3372C)}.ds-msep{height:1px;background:var(--hairline,#E4E4E0);margin:4px 6px}"
    }
