  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one pine action on a screen, with its single-key shortcut.",
      "html": "<button class=\"ds-btn ds-btn-primary\">New board <span class=\"ds-kbd ds-kbd-on\">N</span></button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-ui);font-size:13px;font-weight:500;line-height:1.4;border:none;border-radius:4px;padding:6px 12px;cursor:pointer;transition:background 140ms cubic-bezier(0.16,1,0.3,1),color 140ms cubic-bezier(0.16,1,0.3,1)}.ds-btn-primary{background:var(--accent,#29524A);color:var(--on-accent,#fff);padding-right:7px}.ds-btn-primary:hover{background:var(--accent-hover,#1D3C36)}.ds-btn:focus-visible{outline:2px solid var(--accent,#29524A);outline-offset:2px}.ds-kbd{display:inline-block;font-family:var(--font-mono,'Courier Prime',monospace);font-size:11.5px;line-height:1.35;padding:0 5px;border-radius:2px;box-shadow:inset 0 0 0 1px var(--hairline-strong,#CFCFCA);color:var(--text-muted,#5F5F66)}.ds-kbd-on{box-shadow:inset 0 0 0 1px rgba(255,255,255,0.35);color:inherit}"
    },
    {
      "name": "Secondary and Ghost Buttons",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined secondary action and a quiet ghost action.",
      "html": "<div style=\"display:flex;gap:8px\"><button class=\"ds-btn2 ds-btn-secondary\">Browse</button><button class=\"ds-btn2 ds-btn-ghost\">Trash</button></div>",
      "css": ".ds-btn2{font-family:var(--font-ui);font-size:13px;font-weight:500;line-height:1.4;border:none;border-radius:4px;padding:6px 12px;background:transparent;cursor:pointer;transition:background 140ms cubic-bezier(0.16,1,0.3,1),color 140ms cubic-bezier(0.16,1,0.3,1)}.ds-btn-secondary{box-shadow:inset 0 0 0 1px var(--hairline-strong,#CFCFCA);color:var(--text,#141414)}.ds-btn-ghost{color:var(--text-muted,#5F5F66);font-weight:450;padding:6px 10px}.ds-btn2:hover{background:var(--hover-wash,#F3F3F0);color:var(--text,#141414)}.ds-btn2:focus-visible{outline:2px solid var(--accent,#29524A);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Outlined field; focus becomes a 2px inset pine ring.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Board name</span><input class=\"ds-input\" placeholder=\"Main plot\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:7px;width:320px}.ds-field-label{font-family:var(--font-ui);font-size:13px;font-weight:500;color:var(--text,#141414)}.ds-input{height:36px;padding:0 11px;background:var(--surface,#fff);border:none;border-radius:4px;box-shadow:inset 0 0 0 1px var(--hairline-strong,#CFCFCA);font-family:var(--font-ui);font-size:14px;color:var(--text,#141414);transition:box-shadow 160ms cubic-bezier(0.16,1,0.3,1)}.ds-input::placeholder{color:var(--text-muted,#5F5F66)}.ds-input:focus{outline:none;box-shadow:inset 0 0 0 2px var(--accent,#29524A)}"
    },
    {
      "name": "Running Head",
      "kind": "nav",
      "refersTo": "search-field",
      "description": "Top bar: serif breadcrumb and a centred search field with keys.",
      "html": "<header class=\"ds-topbar\"><nav class=\"ds-crumbs\"><button class=\"ds-crumb\">Projects</button><span class=\"ds-sep\">/</span><span class=\"ds-crumb ds-crumb-on\">The Salt Road</span></nav><button class=\"ds-cmd\"><span class=\"ds-cmd-t\">Search notes and boards</span><span class=\"ds-k\">Ctrl</span><span class=\"ds-k\">K</span></button></header>",
      "css": ".ds-topbar{height:52px;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 16px 0 20px;border-bottom:1px solid var(--hairline,#E4E4E0);background:var(--paper,#fff)}.ds-crumbs{display:flex;align-items:baseline;gap:8px;font-family:var(--font-serif);font-size:15px}.ds-crumb{background:none;border:none;padding:0;font:inherit;color:var(--text-muted,#5F5F66);cursor:pointer;transition:color 140ms cubic-bezier(0.16,1,0.3,1)}button.ds-crumb:hover{color:var(--accent,#29524A)}.ds-crumb-on{color:var(--text,#141414);font-weight:600}.ds-sep{color:var(--text-faint,#A3A3A8)}.ds-cmd{width:300px;height:32px;display:flex;align-items:center;gap:4px;padding:0 7px 0 10px;border:none;background:transparent;border-radius:4px;box-shadow:inset 0 0 0 1px var(--hairline-strong,#CFCFCA);font-family:var(--font-ui);font-size:13px;color:var(--text-muted,#5F5F66);cursor:pointer}.ds-cmd-t{flex:1;text-align:left}.ds-cmd:hover{box-shadow:inset 0 0 0 1px var(--text-faint,#A3A3A8);color:var(--text,#141414)}.ds-cmd:focus-visible,.ds-crumb:focus-visible{outline:2px solid var(--accent,#29524A);outline-offset:2px}.ds-k{font-family:var(--font-mono,'Courier Prime',monospace);font-size:11.5px;padding:0 5px;border-radius:2px;box-shadow:inset 0 0 0 1px var(--hairline-strong,#CFCFCA)}"
    },
    {
      "name": "Segmented Tabs",
      "kind": "nav",
      "refersTo": "segment-tab",
      "description": "Words with a 2px pine underline on the active one.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-seg-item\">Dots</button><button class=\"ds-seg-item ds-seg-on\">Titles</button><button class=\"ds-seg-item\">Cards</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:12px}.ds-seg-item{background:none;border:none;padding:4px 0;font-family:var(--font-ui);font-size:13px;font-weight:500;color:var(--text-muted,#5F5F66);box-shadow:inset 0 -2px 0 transparent;cursor:pointer;transition:color 140ms cubic-bezier(0.16,1,0.3,1),box-shadow 140ms cubic-bezier(0.16,1,0.3,1)}.ds-seg-item:hover{color:var(--text,#141414)}.ds-seg-on{color:var(--text,#141414);box-shadow:inset 0 -2px 0 var(--accent,#29524A)}.ds-seg-item:focus-visible{outline:2px solid var(--accent,#29524A);outline-offset:2px}"
    },
    {
      "name": "Galley List Row",
      "kind": "custom",
      "refersTo": "list-row",
      "description": "Contents line: margin number, serif name, dot leaders, typed details, change bar.",
      "html": "<div class=\"ds-page\"><div class=\"ds-group\">Story <span class=\"ds-tool\">+ Add</span></div><button class=\"ds-row\"><span class=\"ds-num\">2</span><span class=\"ds-name\">Main plot</span><span class=\"ds-leader\"></span><span class=\"ds-mono\">Plot Line · 11</span></button><button class=\"ds-row ds-row-on\"><span class=\"ds-num\">3</span><span class=\"ds-name\">Tomas subplot</span><span class=\"ds-leader\"></span><span class=\"ds-mono\">Plot Line · 3</span></button></div>",
      "css": ".ds-page{padding-left:56px;width:520px}.ds-group{display:flex;justify-content:space-between;align-items:baseline;padding-bottom:6px;margin-bottom:4px;border-bottom:1px solid var(--hairline,#E4E4E0);font-family:var(--font-serif);font-size:17px;font-weight:600;color:var(--text,#141414)}.ds-tool{font-family:var(--font-ui);font-size:13px;font-weight:400;color:var(--text-muted,#5F5F66)}.ds-row{position:relative;display:flex;align-items:baseline;gap:12px;width:100%;padding:9px 0;background:none;border:none;text-align:left;cursor:pointer;outline:none;color:var(--text,#141414)}.ds-row::before{content:\"\";position:absolute;left:-22px;top:8px;bottom:8px;width:2px;background:transparent;transition:background 140ms cubic-bezier(0.16,1,0.3,1)}.ds-row:hover::before{background:var(--hairline-strong,#CFCFCA)}.ds-row-on::before,.ds-row:focus-visible::before{background:var(--accent,#29524A)}.ds-row:focus-visible .ds-name{color:var(--accent,#29524A)}.ds-num{position:absolute;left:-56px;width:26px;text-align:right;font-family:var(--font-mono,'Courier Prime',monospace);font-size:12.5px;color:var(--text-muted,#5F5F66)}.ds-name{font-family:var(--font-serif);font-size:16px;font-weight:500}.ds-leader{flex:1;min-width:24px;height:1em;background:radial-gradient(circle,var(--leader,#BDBDB8) 0.9px,transparent 1.3px) left 100%/6px 4px repeat-x;transform:translateY(-3px)}.ds-mono{font-family:var(--font-mono,'Courier Prime',monospace);font-size:12.5px;color:var(--text-muted,#5F5F66)}"
    },
    {
      "name": "Accent Pill and Category Flag",
      "kind": "chip",
      "refersTo": "pill-accent",
      "description": "Typed labels, not capsules; category colour only as a small flag.",
      "html": "<div style=\"display:flex;gap:16px;align-items:center\"><span class=\"ds-pill\">Pinned</span><span class=\"ds-cat\"><span class=\"ds-flag\" style=\"--chip-color:#7c5cbf\"></span>Character</span></div>",
      "css": ".ds-pill{display:inline-flex;font-family:var(--font-mono,'Courier Prime',monospace);font-size:12.5px;line-height:1.4;padding:1px 6px;border-radius:2px;background:var(--accent-soft,#E4EDEA);color:var(--accent-strong-text,#1E3B38)}.ds-cat{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-ui);font-size:12px;font-weight:500;color:var(--text-muted,#5F5F66)}.ds-flag{width:5px;height:11px;border-radius:1px;background:var(--chip-color)}"
    },
    {
      "name": "Plot Line Query Card",
      "kind": "card",
      "refersTo": "query-card",
      "description": "The selected moment's card, hung from its dot on a pine leader line.",
      "html": "<div class=\"ds-q\"><div class=\"ds-q-where\">Act II · The Ledger · 5 of 11</div><div class=\"ds-q-title\">Fire on the salt flats</div><div class=\"ds-q-prev\">Someone burns the drying sheds. Tomas is seen running from the smoke.</div><button class=\"ds-q-open\">Open note <span class=\"ds-q-k\">Enter</span></button></div>",
      "css": ".ds-q{width:248px;display:flex;flex-direction:column;gap:5px;padding:12px 14px;border-radius:6px;background:var(--surface,#fff);box-shadow:0 0 0 1px var(--accent,#29524A),0 14px 30px -16px rgba(20,20,20,0.35)}.ds-q-where{font-family:var(--font-mono,'Courier Prime',monospace);font-size:12px;color:var(--text-muted,#5F5F66)}.ds-q-title{font-family:var(--font-serif);font-size:17px;font-weight:600;line-height:1.25;color:var(--text,#141414)}.ds-q-prev{font-family:var(--font-serif);font-size:14px;line-height:1.45;color:var(--text-muted,#5F5F66)}.ds-q-open{display:flex;align-items:center;gap:6px;margin-top:2px;background:none;border:none;padding:0;font-family:var(--font-ui);font-size:12px;font-weight:500;color:var(--accent,#29524A);cursor:pointer}.ds-q-open:hover{text-decoration:underline}.ds-q-open:focus-visible{outline:2px solid var(--accent,#29524A);outline-offset:2px}.ds-q-k{font-family:var(--font-mono,'Courier Prime',monospace);font-size:11.5px;padding:0 5px;border-radius:2px;box-shadow:inset 0 0 0 1px var(--hairline-strong,#CFCFCA);color:var(--text-muted,#5F5F66)}"
